---
// Foundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/foundations/elements/Text.astro";
// Components
import PageHero from "@/components/global/PageHero.astro";
---

<BaseLayout title="Page not found" description="This page has moved or never existed." noindex>
  <PageHero title="Page not found" summary="This page has moved or never existed.">
    <Text tag="a" href="/" variant="textBase" class="w-fit text-foreground transition-colors duration-300 hover:text-muted-foreground motion-reduce:transition-none">
      Back home
    </Text>
  </PageHero>
</BaseLayout>
