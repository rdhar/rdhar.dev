---
// Components
import Pagination from "@/components/global/Pagination.astro";
// Content
import { getCollection } from "astro:content";

interface Props {
  currentId: string;
}

const { currentId } = Astro.props;
const works = (await getCollection("work")).sort((a, b) => b.data.start.getTime() - a.data.start.getTime());
const index = works.findIndex((work) => work.id === currentId);
const previous = works[(index - 1 + works.length) % works.length];
const next = works[(index + 1) % works.length];
---

<Pagination
  previous={{ title: previous.data.title, href: `/work/${previous.id}/` }}
  next={{ title: next.data.title, href: `/work/${next.id}/` }}
/>
