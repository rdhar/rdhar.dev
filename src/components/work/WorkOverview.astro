---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Props {
  client: string;
  location: string;
  start: Date;
  end?: Date;
  skills: string;
}

const { client, location, start, end, skills } = Astro.props;
const details = [
  { label: "Company", value: client },
  { label: "Years", value: `${start.getFullYear()}–${end ? end.getFullYear() : "now"}` },
  { label: "Location", value: location },
  { label: "Skills", value: skills },
];
---

<section>
  <Wrapper variant="standard" class="grid grid-cols-1 gap-12 py-24 lg:grid-cols-2">
    <div class="prose prose-sm max-w-lg text-muted-foreground prose-li:text-muted-foreground prose-li:marker:text-muted-foreground">
      <slot />
    </div>
    <dl class="grid grid-cols-2 gap-x-4 gap-y-6 self-start sm:grid-cols-4 lg:grid-cols-2">
      {
        details.map((detail) => (
          <div>
            <dt class="text-sm text-muted-foreground">{detail.label}</dt>
            <dd class="text-sm text-foreground">{detail.value}</dd>
          </div>
        ))
      }
    </dl>
  </Wrapper>
</section>
