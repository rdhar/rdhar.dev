---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<section>
  <Wrapper variant="standard" class="pt-28 pb-14">
    <div class="flex flex-col gap-32">
      <Text tag="h1" variant="displayXL" class="leading-none tracking-tight text-pretty text-foreground lg:text-balance">
        {title}
      </Text>
      <Text tag="p" variant="textSM" class="max-w-xs text-muted-foreground">
        {summary}
      </Text>
    </div>
  </Wrapper>
</section>
