---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="pt-28 pb-14">
    <div class="flex flex-col gap-32">
      <Text tag="h1" variant="displayXL" class="leading-none tracking-tight text-pretty text-foreground lg:text-balance">
        Code, cloud<br />and customer
      </Text>
      <Text tag="p" variant="textSM" class="max-w-xs text-muted-foreground">
        I'm Rishav, a platform engineer in Edinburgh. I help teams ship faster
        and more reliably, with less waiting on infrastructure. Away from work,
        I hike the Scottish crags in search of rare sunshine.
      </Text>
    </div>
  </Wrapper>
</section>
