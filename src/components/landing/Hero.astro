---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="grid grid-cols-1 pt-28 pb-14 lg:grid-cols-2">
    <div class="flex flex-col gap-32">
      <Text tag="h1" variant="displayXL" class="leading-none tracking-tight text-pretty text-foreground lg:text-balance">
        Rishav Dhar<br />Platform engineer
      </Text>
      <Text tag="p" variant="textSM" class="max-w-xs text-muted-foreground">
        Principal Engineer of Platform DevOps at Wavelo. I build secure,
        self-service infrastructure and CI/CD that shorten the loop from code
        to cloud to customer.
      </Text>
    </div>
  </Wrapper>
</section>
