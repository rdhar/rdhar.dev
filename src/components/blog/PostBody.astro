---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Props {
  pubDate: Date;
  readingTime: string;
}

const { pubDate, readingTime } = Astro.props;
const date = pubDate.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const details = [
  { label: "Published", value: date },
  { label: "Reading time", value: readingTime },
];
---

<section>
  <Wrapper variant="standard" class="grid grid-cols-1 gap-12 py-24 lg:grid-cols-2">
    <dl class="flex gap-12 self-start lg:sticky lg:top-6">
      {
        details.map((detail) => (
          <div>
            <dt class="text-sm text-muted-foreground">{detail.label}</dt>
            <dd class="text-sm text-foreground">{detail.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="prose max-w-lg text-muted-foreground prose-headings:font-display prose-headings:font-medium prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-muted-foreground">
      <slot />
    </div>
  </Wrapper>
</section>
