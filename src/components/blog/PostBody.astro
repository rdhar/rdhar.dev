---
// Foundations
import Wrapper from "@/components/foundations/containers/Wrapper.astro";

interface Props {
  id: string;
  title: string;
  pubDate: Date;
  readingTime: string;
  headings: { depth: number; slug: string; text: string }[];
}

const { id, title, pubDate, readingTime, headings } = Astro.props;
const date = pubDate.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const details = [
  { label: "Published", value: date },
  { label: "Reading time", value: readingTime },
];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const url = new URL(`/blog/${id}/`, Astro.site).href;
const email = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`;
const edit = `https://github.com/rdhar/rdhar.dev/blob/main/src/content/posts/${id}.md`;
---

<section>
  <Wrapper variant="standard" class="grid grid-cols-1 gap-12 py-24 lg:grid-cols-2">
    <div class="flex flex-col gap-12 self-start lg:sticky lg:top-6 lg:max-h-[calc(100dvh-3rem)] lg:overflow-y-auto">
      <dl class="flex gap-12">
        {
          details.map((detail) => (
            <div>
              <dt class="text-base md:text-lg text-muted-foreground small-caps">{detail.label}</dt>
              <dd class="text-base md:text-lg text-foreground">{detail.value}</dd>
            </div>
          ))
        }
      </dl>
      {
        toc.length > 0 && (
          <nav aria-labelledby="toc-label" data-toc>
            <h2 id="toc-label" class="text-base md:text-lg text-muted-foreground small-caps">
              Contents
            </h2>
            <ol class="toc text-sm md:text-base">
              {toc.map((heading) => (
                <li class={heading.depth === 3 ? "pl-4" : ""}>
                  <a
                    href={`#${heading.slug}`}
                    class="text-muted-foreground hover:text-foreground"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div>
        <h2 class="text-base md:text-lg text-muted-foreground small-caps">Share</h2>
        <ul class="text-sm md:text-base text-muted-foreground">
          <li>
            <a href={email} class="hover:text-foreground hover:underline">Email</a>
          </li>
          <li>
            <button type="button" class="cursor-pointer hover:text-foreground hover:underline" data-copy-url={url}>Copy link</button>
          </li>
          <li>
            <a href={edit} target="_blank" rel="noopener" class="hover:text-foreground hover:underline">Suggest edit</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="prose max-w-xl md:prose-lg prose-headings:font-normal prose-headings:tracking-tight">
      <slot />
    </div>
  </Wrapper>
</section>

<script>
  // Native `:target-current` styles the active entry in Chromium; elsewhere mirror it with a class from scroll position.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const targets = links.map((link) => document.getElementById(link.hash.slice(1))).filter((el) => el !== null);
  const native = CSS.supports("scroll-target-group: auto");
  const update = () => {
    const current = native
      ? links.find((link) => link.matches(":target-current"))
      : links.find((link) => link.hash === `#${targets.findLast((el) => el.getBoundingClientRect().top <= innerHeight * 0.3)?.id}`);
    for (const link of links) {
      link.setAttribute("aria-current", String(link === current));
      if (!native) link.classList.toggle(":target-current", link === current);
    }
  };
  if (targets.length > 0) {
    update();
    addEventListener(native ? "scrollend" : "scroll", update, { passive: true });
  }

  const copy = document.querySelector<HTMLButtonElement>("[data-copy-url]");
  copy?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(copy.dataset.copyUrl ?? location.href);
    copy.textContent = "Copied";
    setTimeout(() => (copy.textContent = "Copy link"), 2000);
  });
</script>
