---
// Foundations
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
// Components
import BlogCard from "@/components/blog/BlogCard.astro";
import PageHero from "@/components/global/PageHero.astro";
// Content
import { getPosts } from "@/content";

const posts = await getPosts();
---

<PageHero title="Writing" summary="Notes on infrastructure as code, CI/CD and platform engineering." />
<section>
  <Wrapper variant="standard" class="pb-24">
    <ul class="grid grid-cols-1 gap-x-4 sm:grid-cols-2">
      {posts.map((post) => <BlogCard post={post} />)}
    </ul>
  </Wrapper>
</section>
