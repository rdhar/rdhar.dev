---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  title?: string;
  description: string;
  image?: ImageMetadata;
  pubDate?: Date;
}

const name = "Rishav Dhar";
const { title, description, image, pubDate } = Astro.props;
const fullTitle = title ? `${title} · ${name}` : name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image && new URL((await getImage({ src: image, width: 1200, format: "jpeg" })).src, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={name} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={name} href={new URL("rss.xml", Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content={pubDate ? "article" : "website"} />
<meta property="og:site_name" content={name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

<!-- Web Analytics -->
<script is:inline data-goatcounter="https://rdhar.goatcounter.com/count" async src="https://gc.zgo.at/count.v5.js" crossorigin="anonymous" integrity="sha384-atnOLvQb9t+jTSipvd75X2yginT4PjVbqDdlJAmxMm+wYElFmeR6EmLP5bYeoRVQ"></script>
