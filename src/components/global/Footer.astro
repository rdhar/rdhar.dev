---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const contact = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/rishavdhar" },
  { label: "GitHub", href: "https://github.com/rdhar" },
  { label: "Bluesky", href: "https://bsky.app/profile/rdhar.dev" },
  { label: "Book a call", href: "https://cal.com/rdhar/1-1" },
];
const resources = [
  { label: "Work", href: "/work/" },
  { label: "Blog", href: "/blog/" },
  { label: "RSS", href: "/rss.xml" },
  { label: "Source", href: "https://github.com/rdhar/rdhar.dev" },
];
const time = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", hour: "2-digit", minute: "2-digit" }).format(new Date());
const linkClass = "w-fit text-foreground transition-colors duration-300 hover:text-muted-foreground motion-reduce:transition-none";
---

<footer>
  <Wrapper variant="standard" class="pt-24 pb-8">
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 border-t border-muted pt-4 lg:grid-cols-4">
      <Text tag="a" href="/" variant="textBase" class={linkClass}>Rishav Dhar</Text>
      <ul>
        {
          contact.map((item) => (
            <li>
              <Text tag="a" href={item.href} variant="textBase" class={linkClass}>
                {item.label}
              </Text>
            </li>
          ))
        }
      </ul>
      <ul>
        {
          resources.map((item) => (
            <li>
              <Text tag="a" href={item.href} variant="textBase" class={linkClass}>
                {item.label}
              </Text>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-col lg:items-end">
        <Text tag="p" variant="textBase" class="text-foreground">Edinburgh</Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground">
          <time data-clock>{time}</time>
        </Text>
      </div>
    </div>
  </Wrapper>
</footer>

<script>
  const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
  const formatter = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/London", hour: "2-digit", minute: "2-digit" });
  const tick = () => {
    if (clock) clock.textContent = formatter.format(new Date());
  };

  tick();
  setInterval(tick, 10000);
</script>
