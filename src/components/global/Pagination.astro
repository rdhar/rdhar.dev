---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Link {
  title: string;
  href: string;
}

interface Props {
  previous: Link;
  next: Link;
}

const { previous, next } = Astro.props;
const links = [
  { label: "Previous", ...previous },
  { label: "Next", ...next },
];
---

<section>
  <Wrapper variant="standard" class="pb-24">
    <nav class="grid grid-cols-2 gap-4 border-t border-muted pt-6" aria-label="Pagination">
      {
        links.map((link) => (
          <a href={link.href} class="group flex flex-col gap-2">
            <Text tag="span" variant="textBase" class="text-muted-foreground small-caps">
              {link.label}
            </Text>
            <Text
              tag="span"
              variant="displayMD"
              class="leading-none tracking-tight text-foreground transition-colors duration-300 group-hover:text-muted-foreground motion-reduce:transition-none"
            >
              {link.title}
            </Text>
          </a>
        ))
      }
    </nav>
  </Wrapper>
</section>
