---
// Foundations
import Text from "@/components/foundations/elements/Text.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
// Content
import { getPosts, getWorks } from "@/content";

interface Props {
  collection: "posts" | "work";
  currentId: string;
}

const { collection, currentId } = Astro.props;
const [entries, base] = collection === "posts" ? [await getPosts(), "/blog/"] : [await getWorks(), "/work/"];
const index = entries.findIndex((entry) => entry.id === currentId);
const links = [
  { label: "Previous", entry: entries[(index - 1 + entries.length) % entries.length] },
  { label: "Next", entry: entries[(index + 1) % entries.length] },
];
---

<section>
  <Wrapper variant="standard" class="pb-24">
    <nav class="grid grid-cols-2 gap-4 border-t border-muted pt-6" aria-label="Pagination">
      {
        links.map((link) => (
          <a href={`${base}${link.entry.id}/`} class="group flex flex-col gap-2">
            <Text tag="span" variant="textBase" class="text-muted-foreground small-caps">
              {link.label}
            </Text>
            <Text
              tag="span"
              variant="displayMD"
              class="leading-none tracking-tight text-foreground transition-colors duration-300 group-hover:text-muted-foreground motion-reduce:transition-none"
            >
              {link.entry.data.title}
            </Text>
          </a>
        ))
      }
    </nav>
  </Wrapper>
</section>
