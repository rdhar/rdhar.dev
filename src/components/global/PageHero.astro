---
// Foundations
import Text from "@/components/foundations/elements/Text.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";

interface Props {
  title?: string;
  summary: string;
  class?: string;
}

const { title, summary, class: className = "" } = Astro.props;
---

<section>
  <Wrapper variant="standard" class="pt-28 pb-14">
    <div class={`flex flex-col gap-12 ${className}`.trim()}>
      <Text tag="h1" variant="displayXL" class="leading-none tracking-tight text-pretty text-foreground lg:text-balance">
        <slot name="title">{title}</slot>
      </Text>
      <div class="flex flex-col gap-4">
        <Text tag="p" variant="textBase" class="max-w-md text-muted-foreground">
          {summary}
        </Text>
        <slot />
      </div>
    </div>
  </Wrapper>
</section>
