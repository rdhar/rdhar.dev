---
// Foundations
import "@/styles/global.css";
import BaseHead from "@/components/foundations/head/BaseHead.astro";
// Components
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
// Title, description and optional image or date feed the SEO tags:
// <BaseLayout title="Blog" description="...">
const { title, description, image, pubDate, noindex } = Astro.props;
---
<html lang="en-GB">
  <head>
    <BaseHead title={title} description={description} image={image} pubDate={pubDate} noindex={noindex} />
  </head>
  <body class="flex flex-col bg-background min-h-svh">
    <a href="#content" class="sr-only text-base md:text-lg focus:not-sr-only focus:absolute focus:px-2 focus:py-1 focus:top-4 focus:left-4 focus:z-10 focus:bg-background focus:text-foreground">Skip to content</a>
    <Navigation />
    <main id="content" tabindex="-1" class="grow"><slot /></main>
    <Footer />
  </body>
</html>
