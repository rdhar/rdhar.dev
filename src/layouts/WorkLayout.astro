---
// Foundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Components
import PageHero from "@/components/global/PageHero.astro";
import WorkOverview from "@/components/work/WorkOverview.astro";
import Pagination from "@/components/global/Pagination.astro";

const { id, frontmatter } = Astro.props;
const title = `${frontmatter.title} at ${frontmatter.client}`;
---

<BaseLayout title={title} description={frontmatter.summary}>
  <PageHero title={frontmatter.title} summary={frontmatter.summary} />
  <WorkOverview
    client={frontmatter.client}
    location={frontmatter.location}
    start={frontmatter.start}
    end={frontmatter.end}
    skills={frontmatter.skills}
  >
    <slot />
  </WorkOverview>
  <Pagination collection="work" currentId={id} />
</BaseLayout>
