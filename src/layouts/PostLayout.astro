---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Components
import PostHeader from "@/components/blog/PostHeader.astro";
import PostBody from "@/components/blog/PostBody.astro";
import PostMore from "@/components/blog/PostMore.astro";
import PostPagination from "@/components/blog/PostPagination.astro";

const { id, frontmatter, readingTime } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} image={frontmatter.image.url} pubDate={frontmatter.pubDate}>
  <PostHeader title={frontmatter.title} description={frontmatter.description} />
  <PostBody pubDate={frontmatter.pubDate} readingTime={readingTime}>
    <slot />
  </PostBody>
  <PostPagination currentId={id} />
  <PostMore currentId={id} />
</BaseLayout>
